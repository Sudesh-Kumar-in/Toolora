# Copy to .env.local and fill in your values.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
NEXT_PUBLIC_OPERATOR_NAME=Your Company Ltd
# Optional social profiles. Leave empty to hide.
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# Governing law stated in the Terms page.
NEXT_PUBLIC_GOVERNING_LAW=England and Wales
